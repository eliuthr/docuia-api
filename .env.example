# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200
# pretty (local) or json (AWS: one JSON line per log for CloudWatch)
LOG_FORMAT=pretty

# Database: mongodb (local) or dynamodb (AWS)
DATABASE_DRIVER=mongodb
MONGODB_URI=mongodb://localhost:27017/docuia
# Only with DATABASE_DRIVER=dynamodb (set by the CDK stack on AWS)
# DYNAMODB_DOCUMENTS_TABLE=
# DYNAMODB_CONVERSATIONS_TABLE=
# DYNAMODB_MESSAGES_TABLE=

# AWS region of the S3, SQS and DynamoDB clients (set by Lambda on AWS)
AWS_REGION=us-east-1

# Storage: local or s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
# Only with STORAGE_DRIVER=s3
# S3_BUCKET=
MAX_UPLOAD_SIZE_MB=10

# Queue and worker: bullmq (Redis) or sqs
QUEUE_DRIVER=bullmq
# Only with QUEUE_DRIVER=sqs
# SQS_QUEUE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_BACKOFF_MS=5000
WORKER_CONCURRENCY=2

# Status events (worker -> API -> browser): redis, or none (the web client polls)
EVENTS_DRIVER=redis
EVENTS_HEARTBEAT_MS=25000

# LLM (the worker calls the model; never commit a real key)
LLM_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
LLM_TIMEOUT_MS=60000
LLM_MAX_INPUT_CHARS=50000
AGENT_MAX_ITERATIONS=5
